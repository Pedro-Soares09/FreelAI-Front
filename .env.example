# URL base da API do back (FastAPI)
NEXT_PUBLIC_API_URL=http://localhost:8000

# true: telas usam dados de apoio locais (mock). Sem a variável, o mock vale só no
# desenvolvimento local; em build de produção o padrão é a API real. Um build de produção com
# NEXT_PUBLIC_USE_MOCKS=true mostra uma faixa de aviso de dados simulados. Lido no build.
NEXT_PUBLIC_USE_MOCKS=true

# true: recursos de demonstração (simular Pix e posição do check-in). Lido no build.
NEXT_PUBLIC_MODO_DEMO=false

# Endereco publico do app, usado no QR Code da pagina /qr (opcional)
NEXT_PUBLIC_APP_URL=
